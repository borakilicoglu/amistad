{
  "name": "amistad",
  "version": "1.0.0",
  "description": "Terminal-native job search agent with live LinkedIn automation and structured outputs.",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "amistad": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/cli.ts --format esm --clean",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "prepack": "pnpm build",
    "prepare": "husky"
  },
  "keywords": [
    "cli",
    "job-search",
    "linkedin",
    "playwright",
    "mcp",
    "automation",
    "toon"
  ],
  "author": "Bora Kilicoglu",
  "license": "ISC",
  "homepage": "https://github.com/borakilicoglu/amistad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borakilicoglu/amistad.git"
  },
  "bugs": {
    "url": "https://github.com/borakilicoglu/amistad/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@types/node": "^25.7.0",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/mcp": "^0.0.75",
    "@toon-format/toon": "^2.2.0",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  }
}
